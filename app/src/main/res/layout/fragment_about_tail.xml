<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:gravity="start"
		android:orientation="vertical"
		android:paddingStart="@dimen/preference_item_child_padding"
		android:paddingEnd="@dimen/preference_item_child_padding"
		android:paddingTop="@dimen/preference_item_padding_top"
		android:paddingBottom="@dimen/preference_item_padding_bottom">

		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="@dimen/preference_item_padding_top"
			android:gravity="start"
			android:text="@string/about_dynamic"
			android:textColor="@color/color_on_surface_variant"
			android:textSize="@dimen/secondary_text_size" />

		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="@dimen/preference_item_padding_top"
			android:gravity="start"
			android:text="@string/about_unsupported"
			android:textColor="@color/color_on_surface_variant"
			android:textSize="@dimen/secondary_text_size" />
	</LinearLayout>
</ScrollView>