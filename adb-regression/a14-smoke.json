{
  "schemaVersion": 1,
  "planId": "a14-smoke",
  "description": "A14 HyperOS 1 baseline smoke regression for CustoMIUIzer r14",
  "supportedApi": [34],
  "supportedRomFamily": ["hyperos1"],
  "requiredPackages": [
    "tv.withaibuild.customiuizer.r14",
    "com.android.systemui",
    "com.miui.home"
  ],
  "requiredPrivileges": [],
  "variables": {},
  "steps": [
    {
      "id": "baseline-start",
      "type": "collect_diagnostics",
      "description": "Record start timestamp and baseline device state",
      "timeoutSeconds": 60,
      "dangerous": false,
      "manual": false,
      "continueOnFailure": false,
      "evidenceFiles": ["preflight.json"]
    },
    {
      "id": "module-load-markers",
      "type": "logcat_assert",
      "description": "Verify CustoMIUIzer loaded markers for system_server, SystemUI and Launcher",
      "timeoutSeconds": 60,
      "dangerous": false,
      "manual": false,
      "continueOnFailure": false,
      "expected": {
        "patterns": [
          "CustoMIUIzer .* loaded in .*system_server",
          "CustoMIUIzer .* loaded in .*com.android.systemui",
          "CustoMIUIzer .* loaded in .*com.miui.home"
        ]
      },
      "evidenceFiles": ["loaded-markers.json"]
    },
    {
      "id": "hook-summary-systemui",
      "type": "hook_summary",
      "description": "Parse HookSummary for com.android.systemui and detect failures",
      "timeoutSeconds": 60,
      "dangerous": false,
      "manual": false,
      "continueOnFailure": false,
      "expected": {
        "process": "com.android.systemui"
      },
      "evidenceFiles": ["hook-summary.json"]
    },
    {
      "id": "process-stability-snapshot",
      "type": "process_snapshot",
      "description": "Record system_server, SystemUI and Launcher PIDs",
      "timeoutSeconds": 30,
      "dangerous": false,
      "manual": false,
      "continueOnFailure": false,
      "expected": {
        "processes": ["system_server", "com.android.systemui", "com.miui.home"]
      },
      "evidenceFiles": ["process-snapshot-before.json"]
    },
    {
      "id": "crash-scan",
      "type": "logcat_assert",
      "description": "Scan recent logcat for fatal exceptions, watchdog and crash loops",
      "timeoutSeconds": 60,
      "dangerous": false,
      "manual": false,
      "continueOnFailure": false,
      "expected": {
        "absent": [
          "FATAL EXCEPTION",
          "WATCHDOG",
          "system_server crash",
          "SystemUI crash loop",
          "Launcher crash loop"
        ]
      },
      "evidenceFiles": ["crash-scan.json"]
    },
    {
      "id": "broadcast-fast-reboot",
      "type": "broadcast_probe",
      "description": "Negative broadcast probe for FastReboot without token (must be rejected)",
      "timeoutSeconds": 60,
      "dangerous": false,
      "manual": false,
      "continueOnFailure": false,
      "expected": {
        "broadcastKind": "FastReboot",
        "result": "SENTINEL"
      },
      "evidenceFiles": ["broadcast-fast-reboot.json"]
    },
    {
      "id": "broadcast-restart-systemui",
      "type": "broadcast_probe",
      "description": "Negative broadcast probe for RestartSystemUI without token (must be rejected)",
      "timeoutSeconds": 60,
      "dangerous": false,
      "manual": false,
      "continueOnFailure": false,
      "expected": {
        "broadcastKind": "RestartSystemUI",
        "result": "SENTINEL"
      },
      "evidenceFiles": ["broadcast-restart-systemui.json"]
    },

    {
      "id": "tasker-manual-placeholder",
      "type": "manual_checkpoint",
      "description": "Tasker/Locale UnlockSettings manual checkpoint: first open, cancel, re-open, save, re-use, FIRE_SETTING, verify no token or Bundle in logs.",
      "timeoutSeconds": 60,
      "dangerous": false,
      "manual": true,
      "continueOnFailure": false,
      "evidenceFiles": ["manual-checkpoints.json"]
    },
    {
      "id": "final-collection",
      "type": "collect_diagnostics",
      "description": "Collect final diagnostics and process PIDs",
      "timeoutSeconds": 60,
      "dangerous": false,
      "manual": false,
      "continueOnFailure": false,
      "evidenceFiles": ["process-snapshot-after.json", "filtered-logcat.txt"]
    }
  ],
  "cleanup": [
    {
      "id": "cleanup-noop",
      "type": "sleep",
      "description": "No automatic cleanup is performed on the device",
      "timeoutSeconds": 1,
      "dangerous": false,
      "manual": false,
      "continueOnFailure": true
    }
  ],
  "linkedFeatureIds": [],
  "linkedPreferenceKeys": [],
  "evidence": "A14 smoke plan for baseline regression only. No device settings are modified."
}
