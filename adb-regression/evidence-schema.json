{
  "schemaVersion": 1,
  "$schema": "./evidence-schema.json",
  "title": "CustoMIUIzer A14 device evidence proposal",
  "description": "Schema for a bundle of proposed device evidence entries derived from an ADB regression report.",
  "type": "object",
  "required": ["schemaVersion", "planId", "proposals"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "planId": { "type": "string" },
    "testPlanId": { "type": "string" },
    "testPlanSha256": { "type": "string" },
    "timestamp": { "type": "string" },
    "rejected": { "type": "boolean" },
    "rejectionReason": { "type": "string" },
    "evidenceConfidence": {
      "type": "string",
      "enum": ["SIMULATION_ONLY", "UNVERIFIED", "VERIFIED", "PENDING", "SKIPPED", "STALE"]
    },
    "proposals": {
      "type": "array",
      "items": { "$ref": "#/definitions/proposal" }
    }
  },
  "definitions": {
    "proposal": {
      "type": "object",
      "required": [
        "schemaVersion",
        "proposalId",
        "featureId",
        "preferenceKeys",
        "deviceScope",
        "buildFingerprint",
        "romFamily",
        "androidApi",
        "moduleVersion",
        "moduleCommit",
        "testPlanId",
        "testPlanSha256",
        "observedEnableEffect",
        "observedDisableEffect",
        "observedValueChangeEffect",
        "observedRestartTarget",
        "result",
        "timestamp",
        "evidenceFiles",
        "evidenceFileHashes",
        "reviewerStatus",
        "evidenceConfidence"
      ],
      "properties": {
        "schemaVersion": { "type": "integer", "const": 1 },
        "proposalId": { "type": "string" },
        "featureId": { "type": "string" },
        "preferenceKeys": { "type": "array", "items": { "type": "string" } },
        "deviceScope": { "type": "string" },
        "buildFingerprint": { "type": "string" },
        "romFamily": { "type": "string" },
        "androidApi": { "type": "integer" },
        "moduleVersion": { "type": "string" },
        "moduleCommit": { "type": "string" },
        "testPlanId": { "type": "string" },
        "testPlanSha256": { "type": "string" },
        "observedEnableEffect": { "type": "string" },
        "observedDisableEffect": { "type": "string" },
        "observedValueChangeEffect": { "type": "string" },
        "observedRestartTarget": { "type": "string" },
        "result": { "type": "string" },
        "timestamp": { "type": "string" },
        "evidenceFiles": { "type": "array", "items": { "type": "string" } },
        "evidenceFileHashes": { "type": "array", "items": { "type": "string" } },
        "reviewerStatus": { "const": "PENDING_REVIEW" },
        "evidenceConfidence": { "type": "string" }
      }
    }
  }
}
